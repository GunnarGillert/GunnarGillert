<Window x:Class="AlamosHA.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlamosHA - Ersteinrichtung" Height="640" Width="560" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel>
            <TextBlock Text="AlamosHA - Ersteinrichtung" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,16"
                       Text="Diese Angaben werden einmalig benötigt, um diesen Standort mit der Gegenstelle zu verbinden. Der Tailscale-API-Key wird verschlüsselt auf diesem Rechner gespeichert. Bei Fragen siehe README." />

            <TextBlock Text="Standortname (z. B. Büdingen)" FontWeight="SemiBold" Margin="0,8,0,2" />
            <TextBox x:Name="SiteNameBox" />

            <TextBlock Text="Tailnet-Name (aus der Tailscale-Adminkonsole, oder &quot;-&quot; für den Standard-Tailnet)" FontWeight="SemiBold" Margin="0,12,0,2" />
            <TextBox x:Name="TailnetBox" Text="-" />

            <TextBlock Text="Tailscale API-Key (read-only, Scope &quot;devices:core&quot;)" FontWeight="SemiBold" Margin="0,12,0,2" />
            <PasswordBox x:Name="ApiKeyBox" />

            <TextBlock Text="Name des Alamos-Windows-Dienstes auf diesem Rechner" FontWeight="SemiBold" Margin="0,12,0,2" />
            <TextBox x:Name="ServiceNameBox" />

            <TextBlock Text="Gegenstelle: Tailscale-Geräte-ID, Hostname oder Gerätename" FontWeight="SemiBold" Margin="0,12,0,2" />
            <TextBox x:Name="PeerDeviceIdBox" />

            <TextBlock Text="Gegenstelle: Tailscale-Hostname/-IP für die direkte Erreichbarkeitsprüfung" FontWeight="SemiBold" Margin="0,12,0,2" />
            <TextBox x:Name="PeerHostBox" />

            <CheckBox x:Name="IsPrimaryCheckBox" Content="Dieser Standort ist beim allerersten Start automatisch Master (Primary)" Margin="0,16,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#888888" FontSize="11" Margin="0,4,0,0"
                       Text="Wichtig: Genau EINER der beiden Standorte darf dies aktiviert haben, der andere nicht." />

            <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <Button x:Name="SaveButton" Content="Speichern und starten" Padding="12,8" Margin="0,20,0,0" HorizontalAlignment="Left" Click="SaveButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
