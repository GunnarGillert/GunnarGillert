<Window x:Class="AlamosHA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlamosHA" Height="520" Width="560" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SiteNameText" Grid.Row="0" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <Border x:Name="StatusBorder" Grid.Row="1" CornerRadius="8" Padding="16" Background="#DDDDDD">
            <StackPanel>
                <TextBlock x:Name="RoleText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="RoleSubText" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="LastCheckText" Grid.Row="2" Margin="0,12,0,0" FontSize="13" Foreground="#555555" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,8">
            <Button x:Name="ForceMasterButton" Content="Diese Seite zum Master machen" Padding="10,6" Margin="0,0,8,0" Click="ForceMasterButton_Click" />
            <Button x:Name="ForceStandbyButton" Content="Diese Seite auf Standby setzen" Padding="10,6" Margin="0,0,8,0" Click="ForceStandbyButton_Click" />
            <CheckBox x:Name="AutomaticCheckBox" Content="Automatische Umschaltung aktiv" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="True" Checked="AutomaticCheckBox_Changed" Unchecked="AutomaticCheckBox_Changed" />
        </StackPanel>

        <GroupBox Grid.Row="4" Header="Verlauf" Margin="0,8,0,0">
            <ListBox x:Name="LogListBox" FontFamily="Consolas" FontSize="12" />
        </GroupBox>

        <TextBlock Grid.Row="5" Margin="0,8,0,0" FontSize="11" Foreground="#888888" TextWrapping="Wrap"
                    Text="Hinweis: Master = dieser Standort alarmiert aktiv über Alamos. Standby = Bereitschaft, Alamos-Dienst ist gestoppt. Bei Fragen an die IT/Führungsgruppe wenden." />
    </Grid>
</Window>
