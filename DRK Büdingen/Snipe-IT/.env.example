# Kopieren nach ".env" und Werte eintragen. Die ".env" selbst NICHT einchecken
# (siehe .gitignore) - sie enthält Passwörter/Secrets.

# Öffentliche URL, unter der Snipe-IT über den Entra Application Proxy
# erreichbar sein wird (z. B. https://assets.drkbuedingen.de) - auch wenn
# der Container selbst nur intern per HTTP läuft, muss hier die externe
# HTTPS-URL stehen, sonst generiert Snipe-IT falsche Links/Redirects.
#
# Für den Prototyp (docker-compose.prototype.yml, RUNBOOK-Prototyp.md)
# stattdessen: https://<server-ip-oder-interner-hostname>
APP_URL=https://CHANGE-ME.example.org

# Nur für den Prototyp (Caddy-Overlay) nötig: IP-Adresse oder interner
# Hostname, unter dem der Server im Netz erreichbar ist - muss zum Host in
# APP_URL passen (ohne "https://" und ohne Port).
SNIPEIT_HOSTNAME=

# Einmalig erzeugen mit:
#   docker compose run --rm snipeit-app php artisan key:generate --show
# und das Ergebnis (Format: base64:...) hier eintragen.
APP_KEY=

# Datenbank
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=CHANGE-ME-starkes-passwort
DB_ROOT_PASSWORD=CHANGE-ME-anderes-starkes-passwort

# Mail (optional, aber empfohlen für Passwort-Reset/Benachrichtigungen)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDR=
MAIL_FROM_NAME=Snipe-IT DRK Büdingen
